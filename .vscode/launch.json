{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Build Rust (windows-amd64)",
            "runtimeExecutable": "node",
            "program": "${workspaceFolder}/build.js",
            "args": [
                "--only-rust",
                "--distro",
                "windows-amd64"
            ],
            "env": {
                "TAG_NAME": "dev",
                "GITHUB_SHA": "local-build-rust",
                "BUILD_TIME": "1748510000"
            },
            "console": "integratedTerminal"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Build + Run C# (windows-amd64)",
            "runtimeExecutable": "node",
            "program": "${workspaceFolder}/build.js",
            "args": [
                "--csharp",
                "--distro",
                "windows-amd64"
            ],
            "env": {
                "TAG_NAME": "v1.0.0",
                "GITHUB_SHA": "debug-csharp-build",
                "BUILD_TIME": "1748510000"
            },
            "console": "integratedTerminal",
            "postDebugTask": "run-app"
        }
    ]
}